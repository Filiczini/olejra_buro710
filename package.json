{
  "name": "buro710",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n frontend,backend -c auto \"npm --prefix frontend run dev\" \"npm --prefix backend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm run build --workspace=frontend",
    "vercel-build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "lint": "npm run lint --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "seed": "npm run seed --workspace=backend",
    "seed:posts": "npm run seed:posts --workspace=backend",
    "seed:random": "npm run seed --workspace=backend",
    "seed:clean": "npm run seed:clean --workspace=backend",
    "seed:clean:posts": "npm run seed:clean:posts --workspace=backend",
    "seed:admin": "npm run seed:admin --workspace=backend",
    "migrate:projects": "npm run migrate:projects --workspace=backend",
    "validate:i18n": "node scripts/validate-i18n.js",
    "prepare": "husky"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "frontend/src/**/*.{css,json}": [
      "prettier --write"
    ],
    "backend/src/**/*.ts": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
