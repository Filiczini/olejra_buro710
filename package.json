{
  "name": "buro710",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "vercel-build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "lint": "npm run lint --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "seed": "npm run seed --workspace=backend",
    "seed:random": "npm run seed --workspace=backend",
    "seed:clean": "npm run seed:clean --workspace=backend",
    "seed:admin": "npm run seed:admin --workspace=backend",
    "migrate:projects": "npm run migrate:projects --workspace=backend",
    "validate:i18n": "node scripts/validate-i18n.js"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
