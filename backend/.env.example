# Backend Configuration
# ====================

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT secret for authentication tokens (minimum 32 characters recommended)
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars

# Admin credentials for the CMS
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-to-a-secure-password

# Supabase Configuration
# =====================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get chat ID by messaging your bot and checking: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here
