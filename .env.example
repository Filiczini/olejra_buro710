# Backend Configuration
# ====================

# JWT secret for authentication tokens (minimum 32 characters recommended)
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars

# Admin credentials for the CMS
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-to-a-secure-password

# Frontend Configuration
# =====================
VITE_API_URL=http://localhost:3000/api

# PostgreSQL Configuration (self-hosted via Docker)
# =====================
POSTGRES_DB=bureau710
POSTGRES_USER=bureau710_user
POSTGRES_PASSWORD=change-this-to-a-strong-random-password

# Database URL (auto-built from POSTGRES_* vars above)
# For Docker: host is the postgres service name
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# For local dev without Docker, use localhost:
# DATABASE_URL=postgresql://bureau710_user:password@localhost:5432/bureau710

# File uploads directory (local filesystem storage)
# For Docker/production: /app/uploads
# For local dev on Windows: C:/app/uploads or /c/app/uploads
UPLOADS_DIR=/app/uploads

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get chat ID by messaging your bot and checking: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# LEGACY — no longer needed after Supabase migration
# These can be safely removed from production environments
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
